# DanmakuScope - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===========================================
# LLM 配置（由 llm_config.py 管理）
# ===========================================

# ---- 复杂语用任务（情感、合作原则、互动类型、正字法） ----
# 双路推理，使用两个不同温度并行调用
COMPLEX_LLM_BASE_URL=https://api.openai.com/v1
COMPLEX_LLM_API_KEY=sk-xxx
COMPLEX_LLM_MODEL=gpt-4o-mini
# COMPLEX_LLM_TEMPERATURES=[0.1, 0.4]  # 双路温度，默认 [0.1, 0.4]

# ---- 简单句类任务（sentence_function） ----
# 单路推理，温度为 0 确保确定性输出
SIMPLE_LLM_BASE_URL=https://api.deepseek.com/v1
SIMPLE_LLM_API_KEY=sk-yyy
SIMPLE_LLM_MODEL=deepseek-chat
# SIMPLE_LLM_TEMPERATURE=0.0  # 默认 0.0

# ---- 分析报告生成任务（社会语言学语料分析报告） ----
# 独立配置，留空时报告生成将失败（不再自动复用 COMPLEX_LLM）
ANALYSIS_REPORT_LLM_BASE_URL=
ANALYSIS_REPORT_LLM_API_KEY=
ANALYSIS_REPORT_LLM_MODEL=
# ANALYSIS_REPORT_LLM_TEMPERATURE=0.3

# ---- LLM 共识与加权 ----
# ENABLE_DUAL_PATH=True  # 是否启用双路推理
# JSD_THRESHOLD_LOW=0.2  # JSD 低阈值（归一化后相对散度，1.0=完全分歧）
# JSD_THRESHOLD_MEDIUM=0.6  # JSD 中阈值（归一化后相对散度，1.0=完全分歧）
# LOW_CONSENSUS_WEIGHT=0.2  # 低共识权重

# ---- 思考模式（每个 LLM 独立配置，默认全部关闭） ----
# 启用与否取决于各模型是否支持 reasoning/thinking；关闭可避免 content 为空导致的 JSON 解析重试
# SIMPLE_LLM_ENABLE_THINKING=False
# COMPLEX_LLM_ENABLE_THINKING=False
# ANALYSIS_REPORT_LLM_ENABLE_THINKING=False

# ---- Prompt 配置 ----
# PROMPT_VERSION=v2.2.1

# ===========================================
# 业务配置（由 config.py 管理）
# ===========================================

# ---- LLM 分析报告开关 ----
ENABLE_LLM_ANALYSIS_REPORT=True

# ---- 分词策略 ----
# False: jieba+HMM（默认，本地快速）
# True: LLM辅助分词（复用SIMPLE_LLM，更准确但有网络开销）
ENABLE_LLM_TOKENIZER=False
# LLM_TOKENIZER_MIN_LENGTH=20  # 触发LLM分词的最小文本长度

# ---- 抽样与统计核心 ----
MOE=0.05
CONFIDENCE_LEVEL=0.95

# ---- 弹幕采样策略 ----
# False: 每段前N条（默认）
# True: 按频次排序取前N条
ENABLE_FREQ_BASED_SAMPLING=False
TOP_N=10

# ---- 社会变量配置 ----
ENABLE_SIGNIFICANCE_TESTING=False
SIGNIFICANCE_ALPHA=0.05

# ---- 时序动态切分 ----
SEGMENTATION_MODE=dynamic
DYNAMIC_SEGMENT_METHOD=density
MIN_SEGMENT_SAMPLES=30

# ---- 微语境 ----
CONTEXT_TIME_WINDOW=5.0
MAX_CONTEXT_TOKENS=200

# ---- 输出配置 ----
# DATA_ROOT: 用户数据根目录（报告/缓存/日志均存放于此）
# 默认值: ~/.danmaku-scope（Windows: C:\Users\<用户名>\.danmaku-scope）
# 开发调试时可指向项目内目录，如: DATA_ROOT=./data
# DATA_ROOT=

# 以下相对路径均基于 DATA_ROOT 解析，也支持绝对路径
OUTPUT_DIR=reports
CACHE_DIR=cache
LOG_DIR=logs

# ---- 调试 ----
DEBUG=False
LOG_LEVEL=INFO

# ---- B站登录凭证（可选） ----
# 推荐直接使用 `danmaku-analyzer login` 扫码登录（凭证存至 DATA_ROOT/credential.json）
# 以下 .env 配置仅作为最后回退来源（优先级：--credential 文件 > 登录凭证 > .env）
# BILIBILI_SESSDATA=
# BILIBILI_JCT=
# BILIBILI_BUVID3=
