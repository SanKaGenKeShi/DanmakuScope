data/logs/*.log

# Keep directories structure
!danmaku_analyzer/data/cache/.gitkeep
!danmaku_analyzer/data/logs/.gitkeep
!danmaku_analyzer/data/reports/.gitkeep
!danmaku_analyzer/data/raw/.gitkeep

# Large files and model weights
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib

# API keys and secrets (double protection)
**/*secret*
**/*key*
**/*token*
!**/*example*
!**/*template*
